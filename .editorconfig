root = true

[*]
charset = utf-8
end_of_line = lf
tab_width = 4
indent_style = space
indent_size = 4
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

[*.svg]
tab_width = 2
indent_size = 2

[*.{yml,yaml}]
tab_width = 2
indent_size = 2

[*.{json,jsonc}]
tab_width = 2
indent_size = 2
