root = true

[*]
charset = utf-8
end_of_line = lf
tab_width = 4
indent_style = space
indent_size = 4
max_line_length = 80
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
max_line_length = 100

[*.{yml,yaml,json,svg}]
indent_size = 2

[*.md]
max_line_length = 100
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
