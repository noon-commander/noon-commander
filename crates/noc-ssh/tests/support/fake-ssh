#!/bin/sh
# Fake OpenSSH client for Noon Commander tests. It understands the invocations Noon Commander
# makes and serves SFTP with the local sftp-server. Tests wrap it in a script that sets these variables:
#
#   FAKE_SSH_LOG          append each command line here, one argument per line, then --end--
#   FAKE_SSH_PIDS         append the pid of each invocation here
#   FAKE_SSH_BANNER       output of `ssh -V` (default: OpenSSH_9.9p1, FakeSSL 1.0)
#   FAKE_SSH_PASSWORD     ask for a password through $SSH_ASKPASS and require this answer
#   FAKE_SSH_FAIL         fail authentication with this message
#   FAKE_SSH_HANG         never finish authentication
#   FAKE_SSH_USER, FAKE_SSH_HOSTNAME, FAKE_SSH_PORT   values printed by `ssh -G`
#   FAKE_SSH_ROOT         start directory of sftp-server (default: $HOME)
#   FAKE_SSH_SFTP_SERVER  sftp-server binary (default: /usr/libexec/sftp-server)
#
# Like a real master, `ssh -M` creates its control socket only after authentication; here it
# is a regular file holding the master's pid.
set -eu

if [ -n "${FAKE_SSH_LOG:-}" ]; then
    # One write per record, so records of concurrent invocations do not interleave.
    record=
    for arg in "$@"; do
        record="$record$arg
"
    done
    printf '%s--end--\n' "$record" >>"$FAKE_SSH_LOG"
fi
if [ -n "${FAKE_SSH_PIDS:-}" ]; then
    echo $$ >>"$FAKE_SSH_PIDS"
fi

# Noon Commander must start ssh without a controlling terminal (ADR 0003).
if (: </dev/tty) 2>/dev/null; then
    echo "fake-ssh: started with a controlling terminal" >&2
    exit 3
fi

mode=session sock= control= subsystem=no
while [ $# -gt 0 ]; do
    case $1 in
        -V)
            printf '%s\n' "${FAKE_SSH_BANNER:-OpenSSH_9.9p1, FakeSSL 1.0}" >&2
            exit 0
            ;;
        -G) mode=resolve ;;
        -M) mode=master ;;
        -s) subsystem=yes ;;
        -S) shift; sock=$1 ;;
        -O) shift; control=$1 ;;
        -[BbcDEeFIiJLlmoPpQRWw]) shift ;;
        --) shift; break ;;
        -*) ;;
        *) break ;;
    esac
    shift
done
dest=${1:-}

authenticate() {
    if [ -n "${FAKE_SSH_HANG:-}" ]; then
        exec sleep 600
    fi
    if [ -n "${FAKE_SSH_FAIL:-}" ]; then
        printf '%s\n' "$FAKE_SSH_FAIL" >&2
        exit 255
    fi
    if [ -n "${FAKE_SSH_PASSWORD:-}" ]; then
        if [ -z "${SSH_ASKPASS:-}" ] || [ "${SSH_ASKPASS_REQUIRE:-}" != force ]; then
            echo "ssh_askpass: exec(/usr/X11R6/bin/ssh-askpass): No such file or directory" >&2
            echo "Permission denied (password)." >&2
            exit 255
        fi
        if ! answer=$("$SSH_ASKPASS" "$dest's password: ") || [ "$answer" != "$FAKE_SSH_PASSWORD" ]; then
            echo "Permission denied (password)." >&2
            exit 255
        fi
    fi
}

case $control in
    check)
        if [ -e "$sock" ]; then
            echo "Master running (pid=$(cat "$sock"))" >&2
            exit 0
        fi
        echo "Control socket connect($sock): No such file or directory" >&2
        exit 255
        ;;
    exit)
        if [ -e "$sock" ]; then
            kill "$(cat "$sock")" 2>/dev/null || true
            echo "Exit request sent." >&2
            exit 0
        fi
        echo "Control socket connect($sock): No such file or directory" >&2
        exit 255
        ;;
esac

case $mode in
    resolve)
        printf 'host %s\nuser %s\nhostname %s\nport %s\n' "$dest" "${FAKE_SSH_USER:-tester}" \
            "${FAKE_SSH_HOSTNAME:-$dest.example}" "${FAKE_SSH_PORT:-22}"
        exit 0
        ;;
    master)
        authenticate
        trap 'rm -f "$sock"; exit 0' TERM INT
        echo $$ >"$sock"
        while :; do
            sleep 1 &
            wait $! || true
        done
        ;;
esac

if [ "$subsystem" = yes ] && [ "${2:-}" = sftp ]; then
    if [ -n "$sock" ]; then
        if [ ! -e "$sock" ]; then
            echo "Control socket connect($sock): No such file or directory" >&2
            exit 255
        fi
    else
        authenticate
    fi
    exec "${FAKE_SSH_SFTP_SERVER:-/usr/libexec/sftp-server}" -d "${FAKE_SSH_ROOT:-$HOME}"
fi

echo "fake-ssh: unsupported invocation" >&2
exit 2
