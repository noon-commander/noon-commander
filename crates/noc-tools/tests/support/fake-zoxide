#!/bin/sh
# Fake zoxide for Noon Commander tests. It understands the invocations Noon Commander makes.
# Tests wrap it in a script that sets these variables:
#
#   FAKE_ZOXIDE_LOG     append each command line here, one argument per line, then --end--
#   FAKE_ZOXIDE_OUTPUT  print this file for `query`
#   FAKE_ZOXIDE_FAIL    print this to stderr and exit 1
#   FAKE_ZOXIDE_HANG    never finish
set -eu

if [ -n "${FAKE_ZOXIDE_LOG:-}" ]; then
    # One write per record, so records of concurrent invocations do not interleave: the
    # printf of macOS's /bin/sh writes line by line, while cat copies the here-document whole.
    record=
    for arg in "$@"; do
        record="$record$arg
"
    done
    cat >>"$FAKE_ZOXIDE_LOG" <<EOF
${record}--end--
EOF
fi

if [ -n "${FAKE_ZOXIDE_HANG:-}" ]; then
    exec sleep 600
fi
if [ -n "${FAKE_ZOXIDE_FAIL:-}" ]; then
    printf 'zoxide: %s\n' "$FAKE_ZOXIDE_FAIL" >&2
    exit 1
fi

case ${1:-} in
add)
    shift
    [ "${1:-}" = -- ] || { echo "fake-zoxide: add without --" >&2; exit 2; }
    shift
    for dir in "$@"; do
        [ -d "$dir" ] || { echo "zoxide: not a directory: $dir" >&2; exit 1; }
    done
    ;;
query)
    shift
    seen_separator=no
    while [ $# -gt 0 ]; do
        case $1 in
        --list | --score) ;;
        --exclude) shift ;;
        --) seen_separator=yes; shift; break ;;
        *) echo "fake-zoxide: unexpected query argument $1" >&2; exit 2 ;;
        esac
        shift
    done
    [ $seen_separator = yes ] || { echo "fake-zoxide: query without --" >&2; exit 2; }
    if [ -n "${FAKE_ZOXIDE_OUTPUT:-}" ]; then
        cat "$FAKE_ZOXIDE_OUTPUT"
    fi
    ;;
*)
    echo "fake-zoxide: unexpected command ${1:-}" >&2
    exit 2
    ;;
esac
