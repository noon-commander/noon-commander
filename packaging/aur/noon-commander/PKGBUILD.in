# Maintainer: 0ldkettle <packages at noon-commander dot app>

# Rendered by packaging/aur/update.sh for release.yml (ADR 0090); edit this template, never the
# PKGBUILD in the AUR.

pkgname=noon-commander
pkgver=@VERSION@
pkgrel=1
pkgdesc='Terminal file manager focused on seamless local and SFTP file operations'
arch=('x86_64' 'aarch64')
url='https://github.com/@REPOSITORY@'
license=('GPL-3.0-or-later')
depends=('glibc' 'libgcc' 'openssh')
makedepends=('cargo')
optdepends=(
  'fd: find files by name (f f)'
  'ripgrep: search the text of files (f /)'
  'xdg-utils: open files in their applications (g x)'
  'zoxide: jump to frequent directories (g z)'
)
# The release profile strips noc, which would leave a debug package empty. makepkg's LTO can break
# the link of crates with C code, such as BLAKE3 (Rust package guidelines); turning it off leaves
# the Rust code alone, since Cargo.toml asks rustc for LTO itself.
options=('!debug' '!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('@SHA256_SOURCE@')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p noc
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/noc -t "$pkgdir/usr/bin/"
}
