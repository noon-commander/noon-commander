# Rendered by .github/workflows/release.yml into Formula/noon-commander.rb of the tap
# (ADR 0014); edit this template, never the formula in the tap.
class NoonCommander < Formula
  desc "Two-panel terminal file manager for local and SFTP file operations"
  homepage "https://github.com/@REPOSITORY@"
  version "@VERSION@"
  license "GPL-3.0-or-later"

  depends_on :macos

  on_arm do
    url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/noon-commander-@VERSION@-aarch64-apple-darwin.tar.gz"
    sha256 "@SHA256_ARM@"
  end
  on_intel do
    url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/noon-commander-@VERSION@-x86_64-apple-darwin.tar.gz"
    sha256 "@SHA256_INTEL@"
  end

  def install
    bin.install "noc"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/noc --version")
  end
end
